# Copie para .env e ajuste os valores. NUNCA versione o .env real.

# Segredo usado para assinar o cookie de sessão.
# Gere um valor forte, por exemplo:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=troque-por-um-valor-aleatorio-longo

# Porta do servidor
PORT=3000

# Defina como "production" ao publicar (ativa cookie Secure, exige HTTPS)
NODE_ENV=development
