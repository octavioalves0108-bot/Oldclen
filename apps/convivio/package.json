{
  "name": "skytiktok-login",
  "version": "1.0.0",
  "private": true,
  "description": "Exemplo de autenticação segura (design original inspirado em redes sociais). Nenhuma credencial é enviada, registrada ou encaminhada a terceiros.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "seed": "node src/seed.js",
    "dev": "node --watch src/server.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.18.0",
    "helmet": "^8.0.0"
  }
}
